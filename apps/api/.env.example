# ============================================================
# Attendify API — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database (PostgreSQL) ───────────────────────────────────
# Development: local Docker container
DATABASE_URL="postgresql://postgres:password@localhost:5432/attendify?schema=public"

# Production example (Neon / Supabase / Railway):
# DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/attendify?sslmode=require"

# ─── JWT Secrets ─────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=replace_with_64_char_random_string_access
JWT_REFRESH_SECRET=replace_with_64_char_random_string_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google OAuth (optional) ─────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Dev:
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Prod: GOOGLE_CALLBACK_URL=https://attendify.app/auth/google/callback

# ─── SMTP Email (optional) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=noreply@attendify.app

# ─── Frontend URL (used for CORS + email links) ───────────────
# Dev:
FRONTEND_URL=http://localhost:3000
# Prod: FRONTEND_URL=https://attendify.app

# ─── Extra CORS Origins (comma-separated, optional) ──────────
# Add staging/preview URLs here without code changes:
# EXTRA_CORS_ORIGINS=https://attendify-staging.vercel.app,https://preview-123.vercel.app
EXTRA_CORS_ORIGINS=

# ─── Firebase Cloud Messaging (optional) ─────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Security ────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
